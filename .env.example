# GAGE configuration — copy to .env (repo root or working directory).
# Real environment variables always win; .env only fills gaps. Key NAMES are
# logged at startup, values never are.

# ----- API keys (set any subset; mock mode needs none) -----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=          # or GOOGLE_API_KEY
XAI_API_KEY=             # or GROK_API_KEY
OPENROUTER_API_KEY=      # alternative: every vendor through one key

# ----- Internal / private endpoints (no public model APIs) -----
# Point any vendor's protocol at an internal gateway (vLLM, LiteLLM, an
# enterprise proxy, …). A provider with a base URL set is usable even without
# an API key — set the key too only if your gateway expects a bearer token.
#   anthropic: <url>/v1/messages            (Anthropic Messages protocol)
#   openai:    <url>/v1/chat/completions    (OpenAI-compatible — most gateways)
#   gemini:    <url>/v1beta/models/...      (Gemini generateContent protocol)
#   xai:       <url>/v1/chat/completions    (OpenAI-compatible)
ANTHROPIC_BASE_URL=
OPENAI_BASE_URL=
GEMINI_BASE_URL=
XAI_BASE_URL=
OPENROUTER_BASE_URL=

# ----- Per-model endpoints (registry/models.yaml) -----
# For fine-grained control, configure individual model endpoints in
# registry/models.yaml (or set GAGE_MODELS_CONFIG to a custom path).
# Each entry maps a model ref to its endpoint URL:
#
#   - ref: openai:corp-llama-70b
#     endpoint: https://llm-gateway.corp.internal
#   - ref: anthropic:claude-internal
#     endpoint: https://claude-proxy.corp.internal
#     api_key_env: CLAUDE_PROXY_KEY
#
# Per-model endpoints override the vendor base URL for that model only.
# Configured models appear in the UI autocomplete automatically.
GAGE_MODELS_CONFIG=

# ----- Default bench (pre-assigned seat models in the UI) -----
# Comma-separated model refs; each may pin a vendor with a prefix. Override
# this with your internal model names — model ids are configuration, not code.
# GAGE_DEFAULT_MODELS=anthropic:claude-opus-4-8, openai:gpt-5.5, gemini:gemini-3.1-pro-preview
GAGE_DEFAULT_MODELS=
